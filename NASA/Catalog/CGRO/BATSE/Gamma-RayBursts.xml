<?xml version="1.0" encoding="UTF-8"?>
<Spase xmlns="http://www.spase-group.org/data/schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.spase-group.org/data/schema  http://www.spase-group.org/data/schema/spase-2.7.2.xsd">
   <Version>2.7.2</Version>
   <Catalog>
      <ResourceID>spase://NASA/Catalog/CGRO/BATSE/Gamma-RayBursts</ResourceID>
      <ResourceHeader>
         <ResourceName>BASIC TABLE of  triggered gamma-ray bursts</ResourceName>
         <ReleaseDate>2026-09-21T10:24:27</ReleaseDate>
         <Description>The catalog specifies the locations and times for 1637 triggered gamma-ray bursts observed from 19 April, 1991 until 29 August, 1996. </Description>
         <Contact>
            <PersonID>spase://SMWG/Person/William.S.Paciesas</PersonID>
            <Role>Author</Role>
         </Contact>
         <Contact>
            <PersonID>spase://SMWG/Person/Olga.Y.Uritskaya</PersonID>
            <Role>MetadataContact</Role>
         </Contact>
      </ResourceHeader>
      <AccessInformation>
         <RepositoryID>spase://SMWG/Repository/NASA/NSSTC</RepositoryID>
         <AccessURL>
            <URL>https://gammaray.nsstc.nasa.gov/batse/grb/catalog/4b/tables/4br_grossc.basic</URL>
         </AccessURL>
         <Format>HTML</Format>
      </AccessInformation>
      <InstrumentID>spase://SMWG/Instrument/BATSE</InstrumentID>
      <PhenomenonType>RadioBurst</PhenomenonType>
      <TimeSpan>
         <StartDate>1991-04-19T02:19:27</StartDate>
         <StopDate>1996-08-29T02:52:00</StopDate>
      </TimeSpan>
      <Parameter>
         <Name>The BATSE trigger number</Name>
         <Support>
            <SupportQuantity>Housekeeping</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>The BATSE Catalog burst name</Name>
         <Support>
            <SupportQuantity>Other</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name> The truncated Julian Date (TJD) of the trigger</Name>
         <Description> TJD = JD - 2440000.5</Description>
         <Support>
            <SupportQuantity>Temporal</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>The time in decimal seconds of day (UT) of the trigger.</Name>
         <Support>
            <SupportQuantity>Temporal</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Right ascension (J2000) in decimal degrees</Name>
         <Support>
            <SupportQuantity>Other</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Declination (J2000) in decimal degrees</Name>
         <Support>
            <SupportQuantity>Other</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Galactic longitude in decimal degrees</Name>
         <Support>
            <SupportQuantity>Positional</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Galactic latitude in decimal degrees</Name>
         <Support>
            <SupportQuantity>Positional</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Radius in decimal degrees of positional error box</Name>
         <Support>
            <SupportQuantity>Positional</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Angle in decimal degrees of geocenter (the angle between the burst and the nadir, as measured from the satellite)</Name>
         <Support>
            <SupportQuantity>Other</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Overwrite flag: Y(true) if this burst overwrote an earlier, weaker trigger.  N(false) otherwise.</Name>
         <Support>
            <SupportQuantity>Remark</SupportQuantity>
         </Support>
      </Parameter>
      <Parameter>
         <Name>Overwritten flag: Y(true) if this burst was overwritten by a later, more intense trigger.  N(false) otherwise.</Name>
         <Support>
            <SupportQuantity>Remark</SupportQuantity>
         </Support>
      </Parameter>
   </Catalog>
</Spase>
