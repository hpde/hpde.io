	<ProcessingLevel>Calibrated</ProcessingLevel>
	<ProviderName>ICON EUV team</ProviderName>
	<ProviderResourceName></ProviderResourceName>
	<InstrumentID>spase://SMWG/Instrument/ICON/EUV</InstrumentID>
	<MeasurementType>ImageIntensity</MeasurementType>
	<TemporalDescription>
		<TimeSpan>
			<StartDate>2019-12-09T19:01:48Z</StartDate>
			<StopDate>2022-11-03T23:27:18Z</StopDate>
		</TimeSpan>
		<Cadence>PT1800S</Cadence>
	</TemporalDescription>
	<ObservedRegion>Earth.NearSurface.Atmosphere</ObservedRegion>
	<ObservedRegion>Earth.NearSurface.Ionosphere</ObservedRegion>
	
	
	
	<Parameter>
	    <Name>Epoch Time</Name>
	    <ParameterKey>Epoch</ParameterKey>
	    <Description>Time corresponding to the middle of each 48 day average, in milliseconds since Jan 1 1970.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>ms</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>6000000000000</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>Magnitude</Qualifier>
	        <SupportQuantity>Temporal</SupportQuantity>
	    </Support>
    </Parameter> 
	<Parameter>
		<Name>48 day bins</Name>
		<ParameterKey>ICON_L33_Included_Dates</ParameterKey>
		<Description>Dates used in each 48 day bin, in string format, in the format: 2017-05-27.</Description>
		<Cadence>P10D</Cadence>
		<FillValue>-999</FillValue>
		<Support>
		   <Qualifier>Magnitude</Qualifier>
           <SupportQuantity>Temporal</SupportQuantity>
        </Support>
    </Parameter>
		<Parameter>
	    <Name>Binned O+ Density</Name>
	    <ParameterKey>ICON_L33_OPlus</ParameterKey>
	    <Description>Mean value of FUV nighttime O+ Density, taken over all good quality L2 datapoints in a 48-day time-span, as a function of altitude,longitude, latitude, time. Derived from ICON_L24_Disk_ON2.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>1/cm^3</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Particle>
		    <ParticleType>Ion</ParticleType>
			<Qualifier>Average</Qualifier>
	        <ParticleQuantity>NumberDensity</ParticleQuantity>
			<AtomicNumber>8</AtomicNumber>
	    </Particle>
    </Parameter>
	<Parameter>
	    <Name>Binned HMF2</Name>
	    <ParameterKey>ICON_L33_HMF2</ParameterKey>
	    <Description>Binned HMF2. Mean value of HMF2, taken over all good quality L2 datapoints in a 48-day time-span, as a function of longitude, latitude, time. Derived from ICON_L25_HMF2..</Description>
	    <Cadence>P10D</Cadence>
		<Units>km</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>Scalar</Qualifier>
	        <SupportQuantity>Positional</SupportQuantity>
	    </Support>
    </Parameter>
	<Parameter>
	    <Name>Binned NMF2</Name>
	    <ParameterKey>ICON_L33_NMF2</ParameterKey>
	    <Description>Electron density at the peak of the F2 layer from retrieval. Mean value of NMF2, taken over all good quality L2 datapoints in a 48-day time-span, as a function of longitude, latitude, time. Derived from ICON_L25_NMF2.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>1/cm^3</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Particle>
		    <ParticleType>Electron</ParticleType>
			<Qualifier>Average</Qualifier>
	        <ParticleQuantity>NumberDensity</ParticleQuantity>
	    </Particle>
    </Parameter>
	<Parameter>
	    <Name>Number of data points</Name>
	    <ParameterKey>ICON_L33_Datapoints</ParameterKey>
	    <Description>Number of data points in each 48 day average, as a function of altitude, longitude, latitude, time.</Description>
	    <Cadence>P10D</Cadence>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>Scalar</Qualifier>
	        <SupportQuantity>Other</SupportQuantity>
	    </Support>
    </Parameter>
		<Parameter>
	    <Name>Sigma O+ Density</Name>
	    <ParameterKey>ICON_L33_Sigma_OPlus</ParameterKey>
	    <Description>1 standard deviation of the good O+ values used to compute the mean, as a function of altitude, longitude, latitude, time.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>1/cm^3</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Particle>
		    <ParticleType>Ion</ParticleType>
			<Qualifier>StandardDeviation</Qualifier>
	        <ParticleQuantity>NumberDensity</ParticleQuantity>
			<AtomicNumber>8</AtomicNumber>
	    </Particle>
    </Parameter>
	<Parameter>
	    <Name>Sigma HMF2</Name>
	    <ParameterKey>ICON_L33_Sigma_HMF2</ParameterKey>
	    <Description>1 standard deviation of the good column HMF2 values used to compute the mean, as a function of longitude, latitude, time.</Description>
	    <Cadence>P10D</Cadence>
		<Units>km</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>StandardDeviation</Qualifier>
	        <SupportQuantity>Positional</SupportQuantity>
	    </Support>
    </Parameter>
	<Parameter>
	    <Name>Sigma HMF2</Name>
	    <ParameterKey>ICON_L33_Sigma_NMF2</ParameterKey>
	    <Description>Electron density at the peak of the F2 layer from retrieval. 1 standard deviation of the good column NMF2 values used to compute the mean, as a function of longitude, latitude, time.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>1/cm^3</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>1.000000020040877e+20</ValidMax>
		<FillValue>-999</FillValue>
	    <Particle>
		    <ParticleType>Electron</ParticleType>
			<Qualifier>StandardDeviation</Qualifier>
	        <ParticleQuantity>NumberDensity</ParticleQuantity>
	    </Particle>
    </Parameter>
	<Parameter>
	    <Name>Binned Altitude Grid</Name>
	    <ParameterKey>ICON_L33_Altitude</ParameterKey>
	    <Description>Altitude of the O+ data, binned in 4 km intervals, altitude +/- 2.0 km. Derived from ICON_L25_O+_Profile_Altitude.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>km</Units>
		<ValidMin>154</ValidMin>
		<ValidMax>510</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>Direction</Qualifier>
	        <SupportQuantity>Positional</SupportQuantity>
	    </Support>
    </Parameter> 
	<Parameter>
      <Name>Local Time Bin</Name>
      <ParameterKey>ICON_L33_LocalTime</ParameterKey>
      <Description>Local time binned in 0.5 hour intervals, local time +/- 0.25 hours.</Description>
      <Cadence>P10D</Cadence>
      <Units>hours</Units>
      <ValidMin>0.25</ValidMin>
      <ValidMax>23.75</ValidMax>
      <FillValue>-999</FillValue>
      <Support>
        <Qualifier>Direction</Qualifier>
        <SupportQuantity>Positional</SupportQuantity>
      </Support>
    </Parameter>
	<Parameter>
	    <Name>Latitude Bin</Name>
	    <ParameterKey>ICON_L33_Latitude</ParameterKey>
	    <Description>Latitude of the O+ data, binned in 5 degree intervals, latitude +/- 2.5 degrees. Derived from ICON_L25_O+_Profile_Latitude.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>degrees</Units>
		<ValidMin>-10</ValidMin>
		<ValidMax>50</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>Direction</Qualifier>
	        <SupportQuantity>Positional</SupportQuantity>
	    </Support>
    </Parameter>
	<Parameter>
	    <Name>Longitude Bin</Name>
	    <ParameterKey>ICON_L33_Longitude</ParameterKey>
	    <Description>Longitude of the O+ data, binned in 15 degree intervals, longitude +/- 7.5 degrees. Derived from ICON_L25_O+_Profile_Longitude.</Description>
	    <Cadence>P10D</Cadence>
	    <Units>degrees</Units>
		<ValidMin>0</ValidMin>
		<ValidMax>360</ValidMax>
		<FillValue>-999</FillValue>
	    <Support>
	        <Qualifier>Direction</Qualifier>
	        <SupportQuantity>Positional</SupportQuantity>
	    </Support>
    </Parameter>
  </NumericalData>
</Spase>
