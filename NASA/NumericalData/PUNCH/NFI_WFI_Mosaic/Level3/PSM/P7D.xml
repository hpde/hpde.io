      <Parameter>
         <Name>FITS Extension #1 Data Array</Name>
         <Description>PUNCH Level 3 polarized mosaic starfield model stored as a compressed three-dimensional floating-point image cube with three image layers: total brightness (B), polarized brightness (pB), and the conjugate polarized brightness component (pB&#039;). The image dimensions may vary between files. The FITS header provides helioprojective longitude and latitude coordinates with a CAR projection and an alternate ICRS right ascension and declination coordinate system with a STOKES third axis. The pixel scale is 0.02 degrees, or 72 arcsec, at the reference point. The nominal wavelength is 530 nm. The reference time of the model is specified by the DATE-OBS FITS keyword.</Description>
         <Units>2.009e+07 W m^-2 sr^-1</Units>
         <Wave>
            <WaveType>Electromagnetic</WaveType>
            <WaveQuantity>Intensity</WaveQuantity>
            <WavelengthRange>
               <Low>530</Low>
               <High>530</High>
               <Units>nm</Units>
            </WavelengthRange>
         </Wave>
      </Parameter>
