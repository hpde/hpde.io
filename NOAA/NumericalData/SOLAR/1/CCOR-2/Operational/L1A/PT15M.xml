      <Parameter>
         <Name>FITS Extension #1 White-Light Coronal Intensity Data Array</Name>
         <Description>CCOR-2 Level 1A white-light coronal intensity stored in FITS extension #1 as a 2048 x 1920 pixel compressed floating-point image array. The image is expressed in mean solar brightness (MSB) and uses helioprojective solar coordinates with a zenithal polynomial (ZPN) projection. The plate scale is approximately 24.27 arcsec per pixel at the reference point. The CCOR-2 bandpass is approximately 469 to 755 nm. The reference time is specified by the DATE-OBS FITS keyword.</Description>
         <Cadence>PT15M</Cadence>
         <Units>Mean Solar Brightness</Units>
         <Wave>
            <WaveType>Electromagnetic</WaveType>
            <WaveQuantity>Intensity</WaveQuantity>
            <WavelengthRange>
               <Low>469</Low>
               <High>755</High>
               <Units>nm</Units>
            </WavelengthRange>
         </Wave>
      </Parameter>
      <Extension><HelioViewerID>133</HelioViewerID></Extension>
